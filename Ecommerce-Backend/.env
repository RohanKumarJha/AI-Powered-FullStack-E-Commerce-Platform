
# Eureka Configuration
EUREKA_PORT=8761
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka/


# Identity Service
IDENTITY_SERVICE_HOST_PORT=8081


# Identity MySQL
IDENTITY_DATABASE=identity_db
IDENTITY_USER=identity_user
IDENTITY_PASSWORD=identity_password
IDENTITY_ROOT_PASSWORD=root
IDENTITY_MYSQL_HOST_PORT=3306


# Catalog Service
CATALOG_SERVICE_HOST_PORT=8082


# Catalog MongoDB
CATALOG_MONGO_DATABASE=catalog_db
CATALOG_MONGO_HOST=catalog-mongodb
CATALOG_MONGO_PORT=27017


# JWT Secret
JWT_SECRET=ThisIsMySecurityJwtSecretKeyWhichIsResponsibleToMakeSignatureForToken
